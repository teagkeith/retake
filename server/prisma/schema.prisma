// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LineupStatus {
  draft
  submitted
  locked
}

model FantasyLineup {
  id               String       @id @default(cuid())
  fantasyTeamId    String
  scoringWeekId    String
  status           LineupStatus @default(draft)
  starterPlayerIds Json
  lockedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  fantasyTeam      FantasyTeam  @relation(fields: [fantasyTeamId], references: [id])

  @@unique([fantasyTeamId, scoringWeekId])
}

model FantasyTeam {
  id      String                @id
  name    String
  roster  FantasyRosterPlayer[]
  lineups FantasyLineup[]
}

model FantasyRosterPlayer {
  id            String @id @default(cuid())
  fantasyTeamId String
  proPlayerId   String

  fantasyTeam FantasyTeam @relation(fields: [fantasyTeamId], references: [id])

  @@unique([fantasyTeamId, proPlayerId])
}

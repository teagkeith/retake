// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LineupStatus {
  draft
  submitted
  locked
}

model FantasyLineup {
  id               String       @id @default(cuid())
  fantasyTeamId    String
  scoringWeekId    String
  status           LineupStatus @default(draft)
  starterPlayerIds Json
  draftPlayerIds   Json?
  lockedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  fantasyTeam      FantasyTeam  @relation(fields: [fantasyTeamId], references: [id])

  @@unique([fantasyTeamId, scoringWeekId])
}

model FantasyTeam {
  id      String                @id
  name    String
  roster  FantasyRosterPlayer[]
  lineups FantasyLineup[]
}

model FantasyRosterPlayer {
  id            String @id @default(cuid())
  fantasyTeamId String
  proPlayerId   String

  fantasyTeam FantasyTeam @relation(fields: [fantasyTeamId], references: [id])
  proPlayer   ProPlayer   @relation(fields: [proPlayerId], references: [id])

  @@unique([fantasyTeamId, proPlayerId])
}

model Game {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  matches    GameMatch[]
  proPlayers ProPlayer[]
  proTeams   ProTeam[]
}

model GameMatch {
  id              String   @id @default(cuid())
  gameId          String
  externalMatchId String
  durationSeconds Int
  createdAt       DateTime @default(now())

  game        Game               @relation(fields: [gameId], references: [id])
  playerStats PlayerMatchStats[]

  @@unique([gameId, externalMatchId])
}

model PlayerMatchStats {
  id               String     @id @default(cuid())
  gameMatchId      String
  externalPlayerId String
  proPlayerId      String?
  proPlayer        ProPlayer? @relation(fields: [proPlayerId], references: [id])

  kills   Int
  deaths  Int
  assists Int

  stats Json?

  match GameMatch @relation(fields: [gameMatchId], references: [id])

  @@unique([gameMatchId, externalPlayerId])
}

model ProPlayer {
  id               String   @id @default(cuid())
  gameId           String
  displayName      String
  externalPlayerId String?
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())

  game           Game                  @relation(fields: [gameId], references: [id])
  matchStats     PlayerMatchStats[]
  fantasyRosters FantasyRosterPlayer[]

  @@unique([gameId, externalPlayerId])
}

model ProTeam {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  shortName String?
  region    String?
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id])

  @@unique([gameId, name])
}
